<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.polymarket.casino.slots.LuckyNovaController" alignment="CENTER" spacing="20" style="-fx-background-color: #1E1426; -fx-padding: 30;">
    <Label text="Lucky Nova" style="-fx-text-fill: white; -fx-font-size: 24;"/>
    <HBox alignment="CENTER" spacing="15">
        <Label fx:id="reel1" text="?" style="-fx-text-fill: gold; -fx-font-size: 48;"/>
        <Label fx:id="reel2" text="?" style="-fx-text-fill: gold; -fx-font-size: 48;"/>
        <Label fx:id="reel3" text="?" style="-fx-text-fill: gold; -fx-font-size: 48;"/>
    </HBox>
    <Button text="SPIN" onAction="#spin" style="-fx-padding: 10 30; -fx-font-size: 16;"/>
    <Label fx:id="resultLabel" style="-fx-text-fill: white; -fx-font-size: 18;"/>
</VBox>